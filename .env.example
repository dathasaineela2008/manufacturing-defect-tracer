# Copy this file to .env and fill in your local values.
# Never commit a real .env file.

FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string

# mysql  = use MySQL (recommended for the college DBMS demo)
# sqlite = local fallback if MySQL is not installed yet
DB_ENGINE=mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mdtps

# Used only when DB_ENGINE=sqlite
SQLITE_PATH=instance/mdtps.sqlite3
